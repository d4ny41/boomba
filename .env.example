# Spotify app client ID, from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-spotify-client-id
# Spotify app client secret, from the same dashboard page (keep private)
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# OAuth callback; must exactly match a redirect URI registered on the Spotify app
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/callback
# Flask session signing key; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=change-me

# MySQL server hostname
MYSQL_HOST=127.0.0.1
# MySQL server port
MYSQL_PORT=3306
# MySQL user the app connects as
MYSQL_USER=app_user
# Password for MYSQL_USER
MYSQL_PASSWORD=change-me
# Database (schema) name
MYSQL_DATABASE=boomba
# Path to the CA certificate for TLS to MySQL (Aiven: download ca.pem from the service page).
# Leave unset for local Docker MySQL, which connects without SSL.
MYSQL_SSL_CA=

# "development" (default) or "production"; production forces secure cookies and debug off
APP_ENV=development

# Set to 1 to run run.py with the Flask debugger and reloader (never in production); defaults to off
FLASK_DEBUG=0
